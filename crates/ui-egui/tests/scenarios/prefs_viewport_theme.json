[
  {"note": "#4146: under the theme tiles, Viewport draws the 3D view in the Light or Dark theme's colours whatever the window uses; a choice is held until Apply or OK, and Cancel puts it back."},
  {"click": {"handle": "titlebar:preferences"}},
  {"widget": "Interface"},
  {"expect": {"prefs": {"theme": "dark", "dark": true, "viewport_theme": "theme", "viewport_dark": true}}},
  {"widget": "Light", "near": "Viewport"},
  {"expect": {"prefs": {"theme": "dark", "dark": true, "viewport_theme": "theme", "viewport_dark": true}}},
  {"widget": "Apply"},
  {"expect": {"prefs": {"theme": "dark", "dark": true, "viewport_theme": "light", "viewport_dark": false}}},
  {"widget": "Dark", "near": "Viewport"},
  {"expect": {"prefs": {"viewport_theme": "light", "viewport_dark": false}}},
  {"widget": "Light", "near": "Viewport"},
  {"expect": {"prefs": {"viewport_theme": "light", "viewport_dark": false}}},
  {"widget": "Cancel"},
  {"expect": {"prefs": {"dialog": null, "theme": "dark", "viewport_theme": "light", "viewport_dark": false}}}
]
