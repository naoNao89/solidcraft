[
  {"note": "#2255: theme tiles offer the built-in themes; a choice is held until Apply or OK, and Cancel puts the previous theme back."},
  {"click": {"handle": "titlebar:preferences"}},
  {"expect": {"prefs": {"dialog": "General", "theme": "dark", "dark": true}}},
  {"widget": "Interface"},
  {"click": {"handle": "prefs:theme:light"}},
  {"expect": {"prefs": {"theme": "dark", "dark": true}, "shown_handles": ["prefs:theme"]}},
  {"click": {"handle": "prefs:theme:gruvbox-dark"}},
  {"expect": {"prefs": {"theme": "dark", "dark": true}}},
  {"widget": "Apply"},
  {"expect": {"prefs": {"theme": "gruvbox-dark", "dark": true}}},
  {"click": {"handle": "prefs:theme:light"}},
  {"expect": {"prefs": {"theme": "gruvbox-dark", "dark": true}}},
  {"widget": "Cancel"},
  {"expect": {"prefs": {"dialog": null, "theme": "gruvbox-dark", "dark": true}}},
  {"note": "Okibi (dark) and Akari (light) are built in by id; with the dialog closed a `ui.prefs` call sets the theme straight away."},
  {"call": "ui.prefs", "params": {"theme": "akari"}},
  {"expect": {"prefs": {"theme": "akari", "dark": false}}},
  {"call": "ui.prefs", "params": {"theme": "okibi"}},
  {"expect": {"prefs": {"theme": "okibi", "dark": true}}}
]
